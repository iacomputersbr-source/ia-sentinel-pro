{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "IA Sentinel Pro",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": true,
        "scope": ["$APPDATA/**", "$APP/**", "$RESOURCE/**"]
      },
      "os": {
        "all": true
      },
      "dialog": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "identifier": "com.iacomputers.sentinel",
      "icon": ["icons/icon.png"],
      "targets": ["msi"]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "IA Sentinel Pro 2.0",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ]
  }
}
